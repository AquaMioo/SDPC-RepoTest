# ═════════════════════════════════════════════════════════════════════════
#  SDPCC — production environment (Railway + MySQL + Resend)
#
#  Copy these into Railway's Variables tab, NOT into a file. Railway injects
#  them at build and at run; there is no .env on the server.
#
#  Set them on ALL THREE services (web, worker, reverb). A queue worker that
#  cannot reach the database, or a Reverb server without the app key, fails
#  quietly rather than loudly.
#
#  `${{MySQL.X}}` is Railway's own reference syntax — paste it literally and
#  Railway substitutes the value from the MySQL service. Do not copy the
#  password out by hand; it rotates.
# ═════════════════════════════════════════════════════════════════════════

APP_NAME=SDPCC
APP_ENV=production

# Generate ONCE, locally: php artisan key:generate --show
# Paste the whole thing including the base64: prefix. Changing it later logs
# everybody out and makes every encrypted column unreadable.
APP_KEY=

# false. Not "false for now". With debug on, any error page prints your file
# paths, your queries and often your credentials to whoever triggered it.
APP_DEBUG=false

# Your Railway web domain, with https and no trailing slash. Everything
# derives from this: OAuth callbacks, email links, asset URLs.
APP_URL=https://your-app.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# PHP's built-in server handles one request at a time unless this is set, and
# a demo where two people click at once would queue behind each other.
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# `debug` in production writes every query and fills the disk. warning is the
# floor worth keeping; drop to `error` once the showcase is over.
LOG_LEVEL=warning

# ─── Database — Railway MySQL ────────────────────────────────────────────
# Add the MySQL plugin in Railway first, then paste these references as-is.
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# ─── Sessions, cache, queue ──────────────────────────────────────────────
# All three live in MySQL, so there is no Redis to pay for and nothing is
# lost when a container restarts. `php artisan migrate` creates their tables.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/

# null lets the cookie bind to whatever host answers. Set it only if you move
# to a custom domain with subdomains that must share a session.
SESSION_DOMAIN=null

# These three are the reason a session cookie cannot be lifted off the wire.
# Safe to switch on here because Railway serves https and bootstrap/app.php
# now trusts the proxy — without that trust Laravel thinks the request is
# plain HTTP and refuses to set a Secure cookie at all.
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ─── Inertia SSR ─────────────────────────────────────────────────────────
# There is no fourth service running `php artisan inertia:start-ssr`, so this
# is off. Left on, every page render would try to reach an SSR server that
# is not there, fail, and fall back — correct output, wasted round trip each
# time.
INERTIA_SSR_ENABLED=false

# ─── Mail — Resend ───────────────────────────────────────────────────────
# Registration is gated behind an emailed code. If mail does not work, nobody
# can sign up at all — this is the single most important block here.
#
# MAIL_PASSWORD is the Resend API key (starts re_...). MAIL_USERNAME is the
# literal word `resend`, not your email address.
#
# MAIL_FROM_ADDRESS must be on a domain you verified in Resend. Until you
# verify one, Resend only accepts onboarding@resend.dev, and only delivers to
# the address that owns the Resend account — fine for a first smoke test,
# useless for a showcase where other people register.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@your-verified-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── Reverb — live chat ──────────────────────────────────────────────────
# Generate your own trio for production; do not reuse the local ones.
# The key is public (the browser needs it); the secret is not.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# The PUBLIC domain of the reverb SERVICE — not the web service, and with no
# https:// prefix. Port 443 and scheme https, because the browser reaches it
# through Railway's TLS edge even though the process itself listens on $PORT.
REVERB_HOST=your-reverb-service.up.railway.app
REVERB_PORT=443
REVERB_SCHEME=https

# The client build reads these. They are baked into the JavaScript at build
# time, so changing any of them means a rebuild, not just a restart.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Google sign-in ──────────────────────────────────────────────────────
# Leave blank to hide the button entirely and close the OAuth routes. To turn
# it on, register EXACTLY this callback in the Google Cloud Console under
# Credentials → your OAuth client → Authorised redirect URIs:
#     https://your-app.up.railway.app/auth/google/callback
# A mismatch of even a trailing slash is the "We could not sign you in with
# Google" error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ─── Feature switches ────────────────────────────────────────────────────
# Postings must pass admin review before students see them. Leave false.
PROJECTS_AUTO_APPROVE=false

# The money side is built, migrated and tested, and ships off. Turn it on
# only when the payment arrangements are actually settled.
BILLING_ENABLED=false

# Optional third-party student verification. Nothing is gated on the answer.
SHEERID_ENABLED=false
SHEERID_PROGRAM_ID=
SHEERID_ACCESS_TOKEN=

# ─── Seeding ─────────────────────────────────────────────────────────────
# Set BOTH before running db:seed on a public host. Unset they fall back to
# "password", and the seeder creates an administrator with it.
SEED_ADMIN_PASSWORD=
SEED_TESTER_PASSWORD=
