+    /**
+     * Get the tag variant the design uses to render this status.
+     */
+    public function tagVariant(): string
+    {
+        return match ($this) {
+            self::Settled => 'accent',
+            self::Posted => 'outline',
+            self::Pending, self::Failed => 'neutral',
+        };
+    }
