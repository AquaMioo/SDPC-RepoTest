APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# In production set all three. Without SESSION_SECURE_COOKIE the session cookie
# is sent over plain HTTP too, which is the whole ballgame if anyone is on the
# same network. Left unset locally because Herd serves http.
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. `log` is the shipped default and writes every message to
# storage/logs/laravel.log instead of sending it — fine locally, and the
# reason registration codes never arrived in production.
#
# The registration code is the one notification that is NOT queued (see
# App\Notifications\Auth\EmailOneTimePassword): somebody is sitting on the
# screen waiting to type it in. That makes this setting load-bearing — with
# `log` in production, signup silently cannot be completed by anyone.
#
# DO NOT REACH FOR SMTP ON THE DEPLOY HOST. Outbound 587, 465 and 2525 all
# time out from inside the container — shared hosts block SMTP so they cannot
# be used as spam relays. Port 443 is open. This was measured, not assumed,
# and it is why a perfectly valid Gmail App Password still delivered nothing.
#
# So mail goes over HTTPS, through Brevo's transactional API:
#
#   MAIL_MAILER=failover        # brevo, then log. See config/mail.php.
#   MAIL_FROM_ADDRESS=the.verified@address
#   MAIL_FROM_NAME=SDPCC
#   BREVO_API_KEY=xkeysib-...
#
# MAIL_FROM_ADDRESS must be an address verified in Brevo under Senders.
# Brevo verifies a single address by emailing it a confirmation link, which
# is the whole reason it is used here rather than Resend — Resend verifies
# domains, and this project owns none.
#
# MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD are unused by the
# brevo mailer and can stay empty.
#
# Do NOT set MAIL_MAILER=resend. config/mail.php declares that transport but
# resend/resend-laravel is not installed, so it fails with "Unsupported mail
# transport [resend]".
BREVO_API_KEY=
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Passwords DatabaseSeeder gives the accounts it creates. Both fall back to
# "password" when unset, which is fine locally and unsafe anywhere else.
SEED_ADMIN_PASSWORD=
SEED_TESTER_PASSWORD=

# Leave the ID and secret blank to keep "Continue with Google" hidden and the
# OAuth routes closed. The redirect URI must match the one registered in the
# Google Cloud Console exactly, so APP_URL has to be the origin you browse at.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Publish postings straight to the student board, skipping the admin review
# queue. Local demo convenience only — leave this off anywhere real.
PROJECTS_AUTO_APPROVE=false

# Optional third-party student verification. Off by default and optional even
# when on: nothing is gated on the answer, it only earns a badge and gives the
# reviewing administrator one more piece of evidence. Needs a programme id and
# an access token from SheerID before it will do anything.
SHEERID_ENABLED=false
SHEERID_PROGRAM_ID=
SHEERID_ACCESS_TOKEN=

# The money side — the Transaction screen and the milestone ledger — is built,
# migrated and tested, and ships switched off. Turn it on only once the payment
# arrangements are actually settled.
BILLING_ENABLED=false

# Real-time messaging and call signalling run over Laravel Reverb, a WebSocket
# server the app starts itself with `php artisan reverb:start`. Generate your
# own id, key and secret per environment — the key is public because the
# browser needs it, the secret is not. The VITE_ copies are what the client
# build reads, so they must mirror the values above.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Agora Signaling (RTM) — the live "a message just landed" ping. Optional and
# off by default; messaging works without it, just with the 30-second poll
# doing the catching up. The App ID is public (the browser opens the
# connection with it), which is why it has a VITE_ copy. The certificate signs
# tokens, never leaves the server, and must not get one.
AGORA_ENABLED=false
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

VITE_AGORA_APP_ID="${AGORA_APP_ID}"
