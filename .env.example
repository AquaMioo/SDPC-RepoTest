APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# In production set all three. Without SESSION_SECURE_COOKIE the session cookie
# is sent over plain HTTP too, which is the whole ballgame if anyone is on the
# same network. Left unset locally because Herd serves http.
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. `log` is the shipped default and writes every message to
# storage/logs/laravel.log instead of sending it — fine locally, and the
# reason registration codes never arrived in production.
#
# The registration code is the one notification that is NOT queued (see
# App\Notifications\Auth\EmailOneTimePassword): somebody is sitting on the
# screen waiting to type it in. That makes this setting load-bearing — with
# `log` in production, signup silently cannot be completed by anyone.
#
# DO NOT REACH FOR SMTP ON THE DEPLOY HOST. Outbound 587, 465 and 2525 all
# time out from inside the container — shared hosts block SMTP so they cannot
# be used as spam relays. Port 443 is open. This was measured, not assumed,
# and it is why a perfectly valid Gmail App Password still delivered nothing.
#
# So mail goes over HTTPS, through Brevo's transactional API:
#
#   MAIL_MAILER=failover        # brevo, then log. See config/mail.php.
#   MAIL_FROM_ADDRESS=the.verified@address
#   MAIL_FROM_NAME=SDPCC
#   BREVO_API_KEY=xkeysib-...
#
# MAIL_FROM_ADDRESS must be an address verified in Brevo under Senders.
# Brevo verifies a single address by emailing it a confirmation link, which
# is the whole reason it is used here rather than Resend — Resend verifies
# domains, and this project owns none.
#
# MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD are unused by the
# brevo mailer and can stay empty.
#
# Do NOT set MAIL_MAILER=resend. config/mail.php declares that transport but
# resend/resend-laravel is not installed, so it fails with "Unsupported mail
# transport [resend]".
BREVO_API_KEY=
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Passwords DatabaseSeeder gives the accounts it creates. Both fall back to
# "password" when unset, which is fine locally and unsafe anywhere else.
SEED_ADMIN_PASSWORD=
SEED_TESTER_PASSWORD=

# Leave the ID and secret blank to keep "Continue with Google" hidden and the
# OAuth routes closed. The redirect URI must match the one registered in the
# Google Cloud Console exactly, so APP_URL has to be the origin you browse at.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Publish postings straight to the student board, skipping the admin review
# queue. Local demo convenience only — leave this off anywhere real.
PROJECTS_AUTO_APPROVE=false

# Optional third-party student verification. Off by default and optional even
# when on: nothing is gated on the answer, it only earns a badge and gives the
# reviewing administrator one more piece of evidence. Needs a programme id and
# an access token from SheerID before it will do anything.
SHEERID_ENABLED=false
SHEERID_PROGRAM_ID=
SHEERID_ACCESS_TOKEN=

# Proving a student is a student, by mailing a code to an address their school
# issued. The free stand-in for SheerID while that account has not arrived.
#
# WHAT IT PROVES: somebody can open mail on a domain an administrator put on
# the schools table. NOT that they are enrolled this term — alumni keep their
# addresses and staff share the domain. The uploaded document an administrator
# reads is still the stronger evidence and it stays.
#
# OFF BY DEFAULT, AND THAT MATTERS. While every verifier reports itself
# unavailable, User::hasPassedStudentVerification() returns true for EVERYONE —
# which is how the platform behaves today. Turning this on makes every student
# who has not verified fail the gate at once: no applying, no messaging, no
# signing. Seed or backfill the accounts you intend to demo BEFORE you flip it.
#
# It also stays inert until at least one school row carries a domain, so
# switching it on with none configured changes nothing rather than locking
# everybody out.
#
# Deliverability is the real risk, not the code. Most school mailboxes here are
# Microsoft 365, and Microsoft is unforgiving about a gmail.com sender relayed
# through an ESP with no aligned DKIM or DMARC — expect Junk, or a silent
# block. Test to a real school address before you rely on it.
SCHOOL_EMAIL_VERIFICATION_ENABLED=false

# How a student is matched to a posting.
#
#   computed — the shipped default. Stems the brief and the skills and counts
#              the overlap. No key, no network, no cost, and it always answers.
#   gemini   — a language model reads the brief and the profiles and judges the
#              fit, which catches what keywords cannot: "somewhere to track
#              what is in the stockroom" and "inventory management" are the
#              same request, and the two share no words.
#   stored   — read whatever the recommendations table already holds.
#
# Gemini is an improvement, never a dependency. With no key, on a timeout, on a
# refusal, or on a reply in the wrong shape, it falls through to computed and
# logs a warning — nobody browsing ever sees an error or an empty screen.
# Get a key from https://aistudio.google.com/apikey.
RECOMMENDATIONS_DRIVER=computed
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# The money side — the Transaction screen and the milestone ledger — is built,
# migrated and tested, and ships switched off. Turn it on only once the payment
# arrangements are actually settled.
BILLING_ENABLED=false

# Real-time messaging and call signalling run over Laravel Reverb, a WebSocket
# server the app starts itself with `php artisan reverb:start`. Generate your
# own id, key and secret per environment — the key is public because the
# browser needs it, the secret is not. The VITE_ copies are what the client
# build reads, so they must mirror the values above.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# The ${...} below is correct HERE and wrong on Railway. phpdotenv and Vite
# both interpolate ${VAR} when reading a .env file; Railway's variables use
# ${{...}} with two braces and treat one brace as literal text. Copying these
# four lines into the Railway dashboard is how the browser bundle ended up
# containing the string "${REVERB_HOST}" as its WebSocket host — silently, at
# build time, because VITE_ values are compiled in rather than read at runtime.
#
# On Railway, write the resolved values out in full.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Agora RTC — video meetings. Chat's live updates are Reverb's job and have
# nothing to do with these.
#
# Off by default. While AGORA_ENABLED is false the meeting routes 404 and the
# thread hides its Call button, so the module is absent rather than broken.
# Both values come from the Agora console and are 32 characters each.
#
# There is deliberately no VITE_ copy. The App ID reaches the browser inside
# the token response, which the server only answers after checking the caller
# is in that conversation — so there is one fewer build-time variable to get
# wrong, and no way to learn a channel name without being entitled to it.
AGORA_ENABLED=false
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600
